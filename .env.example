# Pública: clave del widget Managed de Cloudflare Turnstile.
# El registro la usa con action=registro; .NET valida con Turnstile__SecretKey.
# En Vercel Preview/Production es obligatoria para registrar cuentas.
VITE_TURNSTILE_SITE_KEY=

# Pública: origen de .NET sin /api ni barra final. HTTPS en Preview/Production.
# Para desarrollo local: http://localhost:5275 en .env.development.local.
# En Vercel: configurar por separado en Preview y Production, y volver a publicar.
# El origen de esta web debe coincidir con FrontendUrl o Cors:AdditionalOrigins de la API.
VITE_API_BASE_URL=

# SOLO servidor. Nunca usar el prefijo VITE_ para estos valores.
TURNSTILE_SECRET_KEY=
FORMS_ALLOWED_ORIGINS=https://www.lalibertadavanzasantafe.com
GOOGLE_APPS_SCRIPT_URL=
# Generar 32 bytes aleatorios (64 caracteres hex) y copiar también a Apps Script.
GOOGLE_APPS_SCRIPT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Límites compartidos por los dos formularios, configurables.
FORMS_IP_HOURLY_LIMIT=5
FORMS_DAILY_LIMIT=500
FORMS_RATE_NAMESPACE=lla:forms:production:v1
